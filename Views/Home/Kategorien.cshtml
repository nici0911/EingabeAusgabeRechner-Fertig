@using Kassabuch.Konfiguration
@model KassabuchViewModel
@{
    ViewData["Title"] = "Kategorien";
}

<section class="page-head">
    <h1>Kategorien</h1>
    <a asp-action="Index">Zurück zur Übersicht</a>
</section>

<section class="panel category-page">
    <h2>Neue Kategorie</h2>
    <form asp-action="KategorieAnlegen" method="post" class="category-form">
        <input asp-for="NeueKategorie.Name" maxlength="@ProjektEinstellungen.KategorieMaxZeichen" placeholder="Neue Kategorie" />
        <input asp-for="NeueKategorie.Farbe" type="color" aria-label="Kategoriefarbe" />
        <button type="submit">Hinzufügen</button>
    </form>
    <div asp-validation-summary="All" class="validation"></div>

    <div class="category-list">
        @foreach (var kategorie in Model.Kategorien)
        {
            <div class="row"><span><i class="dot" style="background:@kategorie.Farbe"></i>@kategorie.Name</span><form asp-action="KategorieLoeschen" method="post"><input type="hidden" name="id" value="@kategorie.Id" /><button class="danger" type="submit">Löschen</button></form></div>
        }
    </div>
</section>
