@using Kassabuch.Konfiguration
@model KassabuchViewModel
@{
    ViewData["Title"] = "Kassabuch / Einnahmen-Ausgaben-Rechner";
    var waehrung = CultureInfo.GetCultureInfo("de-AT");
    var maxDatum = ProjektEinstellungen.MaxDatum.ToString("yyyy-MM-dd");
}

<section class="page-head">
    <h1>Kassabuch / Einnahmen-Ausgaben-Rechner</h1>
    <p class="balance">
        <span>Aktueller Kontostand</span>
        <strong class="@(Model.Kassenstand < 0 ? "expense" : "income")">@Model.Kassenstand.ToString("C", waehrung)</strong>
    </p>
</section>

<section class="summary" aria-label="Summen der aktuellen Auswahl">
    <p><span>Einnahmen</span><strong class="income">@Model.SummeEinnahmen.ToString("C", waehrung)</strong></p>
    <p><span>Ausgaben</span><strong class="expense">@Model.SummeAusgaben.ToString("C", waehrung)</strong></p>
</section>

<section class="panel">
    <div class="row"><h2>Filter</h2><a asp-action="Index">Alle Filter löschen</a></div>
    <form asp-action="Index" method="get" class="filter-grid">
        <label>Text oder Belegnummer
            <input name="Suche" value="@Model.Filter.Suche" placeholder="z. B. Miete" />
        </label>
        <label>Von
            <input type="date" name="Von" value="@(Model.Filter.Von?.ToString("yyyy-MM-dd"))" max="@maxDatum" />
        </label>
        <label>Bis
            <input type="date" name="Bis" value="@(Model.Filter.Bis?.ToString("yyyy-MM-dd"))" max="@maxDatum" />
        </label>
        <label>Kategorie
            <select name="KategorieId">
                <option value="">Alle</option>
                @foreach (var kategorie in Model.Kategorien)
                {
                    <option value="@kategorie.Id" selected="@(Model.Filter.KategorieId == kategorie.Id)">@kategorie.Name</option>
                }
            </select>
        </label>
        <label>Betrag von
            <input type="number" min="0" step="0.01" name="Mindestbetrag" value="@Model.Filter.Mindestbetrag" />
        </label>
        <label>Betrag bis
            <input type="number" min="0" step="0.01" name="Hoechstbetrag" value="@Model.Filter.Hoechstbetrag" />
        </label>
        <label>Sortierung
            <select name="Sortierung">
                <option value="datum_ab" selected="@(Model.Filter.Sortierung == "datum_ab")">Datum absteigend</option>
                <option value="datum_auf" selected="@(Model.Filter.Sortierung == "datum_auf")">Datum aufsteigend</option>
                <option value="betrag_ab" selected="@(Model.Filter.Sortierung == "betrag_ab")">Betrag absteigend</option>
                <option value="betrag_auf" selected="@(Model.Filter.Sortierung == "betrag_auf")">Betrag aufsteigend</option>
            </select>
        </label>
        <button type="submit">Anwenden</button>
    </form>
</section>

<div class="columns">
    <div class="stack">
        <section class="panel">
            <div class="row"><h2>Transaktionen</h2><span class="count">@Model.Zeilen.Count Einträge</span></div>
            @if (Model.Zeilen.Count == 0)
            {
                <p class="empty">Keine passenden Transaktionen gefunden.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Datum</th><th>Beleg</th><th>Beschreibung</th><th>Kategorie</th><th class="number">Einnahme</th><th class="number">Ausgabe</th><th class="number">Saldo</th><th>Aktion</th></tr></thead>
                        <tbody>
                        @foreach (var zeile in Model.Zeilen)
                        {
                            <tr>
                                <td>@zeile.Buchung.Datum.ToString("dd.MM.yyyy")</td>
                                <td>@zeile.Buchung.Belegnummer</td>
                                <td>@zeile.Buchung.Buchungstext</td>
                                <td><span><i class="dot" style="background:@zeile.Buchung.Kategorie.Farbe"></i>@zeile.Buchung.Kategorie.Name</span></td>
                                <td class="number income">@(zeile.Buchung.Einnahme > 0 ? zeile.Buchung.Einnahme.ToString("C", waehrung) : "–")</td>
                                <td class="number expense">@(zeile.Buchung.Ausgabe > 0 ? zeile.Buchung.Ausgabe.ToString("C", waehrung) : "–")</td>
                                <td class="number">@zeile.LaufenderSaldo.ToString("C", waehrung)</td>
                                <td class="actions">
                                    <a asp-action="Index" asp-route-bearbeiten="@zeile.Buchung.Id" asp-fragment="buchungsformular">Bearbeiten</a>
                                    <form asp-action="Loeschen" method="post" onsubmit="return confirm('Buchung wirklich löschen?');">
                                        <input type="hidden" name="id" value="@zeile.Buchung.Id" />
                                        <button class="danger" type="submit">Löschen</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel">
            <h2>Bericht</h2>
            <form asp-action="Index" method="get" class="inline-form">
                <input type="hidden" name="Suche" value="@Model.Filter.Suche" />
                <input type="hidden" name="Von" value="@(Model.Filter.Von?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="Bis" value="@(Model.Filter.Bis?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="KategorieId" value="@Model.Filter.KategorieId" />
                <input type="hidden" name="Mindestbetrag" value="@Model.Filter.Mindestbetrag" />
                <input type="hidden" name="Hoechstbetrag" value="@Model.Filter.Hoechstbetrag" />
                <input type="hidden" name="Sortierung" value="@Model.Filter.Sortierung" />
                <select name="Bericht">
                    <option value="tag" selected="@(Model.Filter.Bericht == "tag")">Täglich</option>
                    <option value="woche" selected="@(Model.Filter.Bericht == "woche")">Wöchentlich</option>
                    <option value="monat" selected="@(Model.Filter.Bericht == "monat")">Monatlich</option>
                </select>
                <button type="submit">Bericht anzeigen</button>
            </form>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Zeitraum</th><th class="number">Einnahmen</th><th class="number">Ausgaben</th><th class="number">Ergebnis</th></tr></thead>
                    <tbody>
                    @foreach (var zeile in Model.Bericht)
                    {
                        <tr><td>@zeile.Zeitraum</td><td class="number income">@zeile.Einnahmen.ToString("C", waehrung)</td><td class="number expense">@zeile.Ausgaben.ToString("C", waehrung)</td><td class="number">@zeile.Saldo.ToString("C", waehrung)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <aside>
        <section class="panel" id="buchungsformular">
            @if (Model.Bearbeitung is not null && Model.BearbeitenId.HasValue)
            {
                <h2>Buchung bearbeiten</h2>
                <form asp-action="Bearbeiten" method="post">
                    <input type="hidden" name="id" value="@Model.BearbeitenId" />
                    <div asp-validation-summary="All" class="validation"></div>
                    <label>Belegnummer<input name="Bearbeitung.Belegnummer" maxlength="@ProjektEinstellungen.BelegnummerMaxZeichen" value="@Model.Bearbeitung.Belegnummer" /></label>
                    <label>Datum<input type="date" name="Bearbeitung.Datum" max="@maxDatum" value="@Model.Bearbeitung.Datum.ToString("yyyy-MM-dd")" /></label>
                    <label>Beschreibung<input name="Bearbeitung.Buchungstext" maxlength="@ProjektEinstellungen.BeschreibungMaxZeichen" value="@Model.Bearbeitung.Buchungstext" /></label>
                    <label>Kategorie<select name="Bearbeitung.KategorieId">@foreach (var kategorie in Model.Kategorien) { <option value="@kategorie.Id" selected="@(Model.Bearbeitung.KategorieId == kategorie.Id)">@kategorie.Name</option> }</select></label>
                    <div class="amount-grid"><label>Einnahme<input class="amount-income" type="number" min="0" step="0.01" name="Bearbeitung.Einnahme" value="@Model.Bearbeitung.Einnahme" /></label><label>Ausgabe<input class="amount-expense" type="number" min="0" step="0.01" name="Bearbeitung.Ausgabe" value="@Model.Bearbeitung.Ausgabe" /></label></div>
                    <button type="submit">Änderungen speichern</button>
                    <a asp-action="Index">Abbrechen</a>
                </form>
            }
            else
            {
                <h2>Buchung hinzufügen</h2>
                <form asp-action="Anlegen" method="post">
                    <div asp-validation-summary="All" class="validation"></div>
                    <label asp-for="NeueBuchung.Belegnummer"></label>
                    <input asp-for="NeueBuchung.Belegnummer" maxlength="@ProjektEinstellungen.BelegnummerMaxZeichen" placeholder="z. B. B-104" />
                    <label asp-for="NeueBuchung.Datum"></label>
                    <input asp-for="NeueBuchung.Datum" type="date" max="@maxDatum" />
                    <label asp-for="NeueBuchung.Buchungstext"></label>
                    <input asp-for="NeueBuchung.Buchungstext" maxlength="@ProjektEinstellungen.BeschreibungMaxZeichen" placeholder="Kurze Beschreibung" />
                    <label asp-for="NeueBuchung.KategorieId"></label>
                    <select asp-for="NeueBuchung.KategorieId"><option value="0">Bitte wählen</option>@foreach (var kategorie in Model.Kategorien) { <option value="@kategorie.Id">@kategorie.Name</option> }</select>
                    <div class="amount-grid"><label asp-for="NeueBuchung.Einnahme"></label><input asp-for="NeueBuchung.Einnahme" class="amount-income" type="number" min="0" step="0.01" /><label asp-for="NeueBuchung.Ausgabe"></label><input asp-for="NeueBuchung.Ausgabe" class="amount-expense" type="number" min="0" step="0.01" /></div>
                    <button type="submit">Buchung speichern</button>
                </form>
            }
        </section>

    </aside>
</div>
